# GEMINI_API_KEY: Required for Gemini AI Auto Mark & evaluation calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional override for Admin sign-in passcode (supports ADMIN_PASSCODE or ADMIN secret)
ADMIN_PASSCODE=
ADMIN=
